{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "TargetSql": "Server=tcp:<sql-server>.database.windows.net,1433;Initial Catalog=<target-database>;Persist Security Info=False;User ID=<sql-user>;Password=__SET_VIA_USER_SECRETS__;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;"
  },
  "Databricks": {
    "WorkspaceUrl": "https://__YOUR_WORKSPACE__.azuredatabricks.net",
    "AuthMode": "PersonalAccessToken",
    "RequestTimeout": "00:10:00"
  },
  "Migration": {
    "StageRootPath": "/Volumes/<catalog>/<schema>/<volume>",
    "RunId": "",
    "SourceFolders": {
      "ItemCategory": "itemcategory",
      "Blob": "blob",
      "Item": "item",
      "ItemBlob": "itemblob"
    },
    "BatchSize": 5000,
    "SqlCommandTimeout": "00:30:00",
    "Interval": "01:00:00",
    "RunOnce": false,
    "SkipCompletedTables": true,
    "SkipTables": [],
    "PruneMissingRows": false,
    "ExcludeDeletedItems": true,
    "ExcludeInactiveItems": false,
    "ReseedIdentityColumns": true,
    "EnsureMigrationObjects": true,
    "AllowEmptySourceFolders": false
  }
}
